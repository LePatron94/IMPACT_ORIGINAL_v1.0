{%- comment -%}Rotuleo : hero « promesse » (image lifestyle + titre bénéfice + sous-titre promesse). Volontairement sans bouton d'achat.{%- endcomment -%}
<div class="rt-hero">
  <div class="rt-hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign alt = section.settings.image.alt | default: section.settings.title | strip_html -%}
      {{- section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: alt, sizes: '(max-width: 999px) 100vw, 55vw', widths: '400,600,800,1000,1200,1500,1800', style: section.settings.image_focus -}}
    {%- else -%}
      {{- 'lifestyle-1' | placeholder_svg_tag -}}
    {%- endif -%}
  </div>

  <div class="rt-hero__content">
    <div class="rt-hero__inner">
      {%- if section.settings.rating_text != blank -%}
        <p class="rt-hero__rating">
          <span class="rt-stars">{%- for i in (1..5) -%}{%- render 'rt-icon', name: 'star' -%}{%- endfor -%}</span>
          <span>{{ section.settings.rating_text | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="rt-hero__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<div class="rt-hero__sub">{{ section.settings.subtitle }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="rt-hero__points" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{%- render 'rt-icon', name: 'check', inner: '#0d2e57' -%}<span>{{ block.settings.text | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rotuleo – Hero promesse",
  "class": "shopify-section--rt-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image lifestyle (produit en situation)" },
    { "type": "select", "id": "image_focus", "label": "Cadrage de l'image", "default": "object-position: center 35%", "options": [ { "value": "object-position: center top", "label": "Haut" }, { "value": "object-position: center 35%", "label": "Centre haut" }, { "value": "object-position: center", "label": "Centre" }, { "value": "object-position: center bottom", "label": "Bas" } ] },
    { "type": "text", "id": "rating_text", "label": "Note", "default": "4,7/5 · 202 avis vérifiés" },
    { "type": "inline_richtext", "id": "title", "label": "Titre bénéfice", "info": "Mettez un mot en gras pour l'afficher en turquoise.", "default": "Enfin, <strong>le soulagement</strong> que vos genoux attendaient." },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre promesse" }
  ],
  "blocks": [
    { "type": "point", "name": "Point de réassurance", "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Satisfait ou remboursé 60 jours" } ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Rotuleo – Hero promesse" }]
}
{% endschema %}
