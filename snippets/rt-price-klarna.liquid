{%- comment -%}
  Rotuleo : prix + paiement en 3x Klarna sous le titre.
  Le prix et la mensualité suivent l'offre Kaching sélectionnée.
{%- endcomment -%}
{%- assign rt_variant = product.selected_or_first_available_variant -%}
{%- assign rt_n = 3 -%}
{%- assign rt_part = rt_variant.price | plus: 2 | divided_by: rt_n -%}
<style>
  .product-info > .rt-price { margin-block: 8px !important; display: grid; gap: 6px; }
  .rt-price__amount { margin: 0; font-family: var(--heading-font-family); font-weight: var(--heading-font-weight, 700); font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem); line-height: 1.1; letter-spacing: -.01em; color: var(--rt-navy, #0d2e57); }
  .rt-price__klarna { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--rt-ink, #0f2440); }
  .rt-price__klarna strong { font-weight: 700; color: var(--rt-navy, #0d2e57); }
  .rt-price__badge { display: inline-block; margin-inline-start: 4px; padding: 2px 10px; border-radius: 8px; background: #ffb3c7; color: #0b051d; font-weight: 800; font-size: .95rem; line-height: 1.5; vertical-align: middle; }
</style>
<div class="rt-price" data-rt-price data-installments="{{ rt_n }}">
  <p class="rt-price__amount" data-rt-price-amount>{{ rt_variant.price | money }}</p>
  <p class="rt-price__klarna">ou {{ rt_n }}× <strong data-rt-price-part>{{ rt_part | money }}</strong> sans frais avec <span class="rt-price__badge">Klarna.</span></p>
</div>
<script>
  (function () {
    var box = document.currentScript && document.currentScript.previousElementSibling;
    if (!box || !box.hasAttribute('data-rt-price')) return;
    var n = parseInt(box.getAttribute('data-installments'), 10) || 3;
    var amountEl = box.querySelector('[data-rt-price-amount]');
    var partEl = box.querySelector('[data-rt-price-part]');
    var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR';
    var fmt = function (v) { return new Intl.NumberFormat(document.documentElement.lang || 'fr-FR', { style: 'currency', currency: currency }).format(v); };
    var parse = function (txt) {
      var s = (txt || '').replace(/[^\d,.]/g, '');
      if (s.indexOf(',') > -1) { s = s.replace(/\./g, '').replace(',', '.'); }
      var v = parseFloat(s);
      return isNaN(v) ? null : v;
    };
    var update = function () {
      var el = document.querySelector('.kaching-bundles__bar--selected .kaching-bundles__bar-price');
      var total = el ? parse(el.textContent) : null;
      if (total === null) return;
      amountEl.textContent = fmt(total);
      partEl.textContent = fmt(Math.ceil(total * 100 / n) / 100);
    };
    var watch = function () {
      var root = document.querySelector('.kaching-bundles');
      if (!root) return false;
      new MutationObserver(update).observe(root, { subtree: true, attributes: true, attributeFilter: ['class'], childList: true, characterData: true });
      update();
      return true;
    };
    document.addEventListener('change', function (e) { if (e.target.closest && e.target.closest('.kaching-bundles')) setTimeout(update, 0); });
    if (!watch()) {
      var tries = 0;
      var timer = setInterval(function () { if (watch() || ++tries > 40) clearInterval(timer); }, 250);
    }
  })();
</script>
