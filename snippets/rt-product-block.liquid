{%- comment -%}Rotuleo : blocs personnalisés de la fiche produit (preuve sociale, points clés, offre limitée, réassurance){%- endcomment -%}
{%- case block.type -%}
  {%- when 'rt_proof' -%}
    <div class="rt-proof" {{ block.shopify_attributes }}>
      <span id="rt-acheter" class="rt-anchor"></span>
      {%- if block.settings.rating_text != blank -%}
        <p class="rt-proof__rating">
          <span class="rt-stars">{%- for i in (1..5) -%}{%- render 'rt-icon', name: 'star' -%}{%- endfor -%}</span>
          <span class="rt-proof__score">{{ block.settings.rating_text | escape }}</span>
        </p>
      {%- endif -%}
      {%- if block.settings.proof_text != blank -%}
        <p class="rt-proof__people">
          <span class="rt-proof__avatars" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- assign key = 'avatar_' | append: i -%}
              {%- if block.settings[key] != blank -%}{{ block.settings[key] | image_url: width: 80 | image_tag: loading: 'lazy', width: 26, height: 26, alt: '' }}{%- endif -%}
            {%- endfor -%}
          </span>
          <span>{{ block.settings.proof_text | escape }}</span>
        </p>
      {%- endif -%}
    </div>

  {%- when 'rt_points' -%}
    <ul class="rt-points" role="list" {{ block.shopify_attributes }}>
      {%- for i in (1..5) -%}
        {%- assign key = 'point_' | append: i -%}
        {%- if block.settings[key] != blank -%}
          <li>{%- render 'rt-icon', name: 'check' -%}<span>{{ block.settings[key] }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  {%- when 'rt_deadline' -%}
    {%- if block.settings.end_date != blank -%}
      {%- assign rt_end = block.settings.end_date | date: '%s' | plus: 0 -%}
      {%- assign rt_now = 'now' | date: '%s' | plus: 0 -%}
      {%- if rt_end > rt_now -%}
        <div class="rt-deadline" data-rt-deadline="{{ rt_end }}" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<p class="rt-deadline__title">{{ block.settings.title | escape }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="rt-deadline__sub">{{ block.settings.text | escape }}</p>{%- endif -%}
          <div class="rt-deadline__timer" aria-hidden="true">
            <span><b data-u="d">--</b><small>j</small></span>
            <span><b data-u="h">--</b><small>h</small></span>
            <span><b data-u="m">--</b><small>min</small></span>
            <span><b data-u="s">--</b><small>s</small></span>
          </div>
        </div>
        <script>
          (function () {
            var el = document.currentScript && document.currentScript.previousElementSibling;
            if (!el || !el.dataset.rtDeadline) return;
            var end = parseInt(el.dataset.rtDeadline, 10) * 1000;
            var pad = function (n) { return String(n).padStart(2, '0'); };
            var timer = null;
            var tick = function () {
              var d = end - Date.now();
              if (d <= 0) { el.hidden = true; if (timer) clearInterval(timer); return; }
              var s = Math.floor(d / 1000);
              el.querySelector('[data-u="d"]').textContent = pad(Math.floor(s / 86400));
              el.querySelector('[data-u="h"]').textContent = pad(Math.floor((s % 86400) / 3600));
              el.querySelector('[data-u="m"]').textContent = pad(Math.floor((s % 3600) / 60));
              el.querySelector('[data-u="s"]').textContent = pad(s % 60);
            };
            tick();
            timer = setInterval(tick, 1000);
          })();
        </script>
      {%- endif -%}
    {%- endif -%}

  {%- when 'rt_trust' -%}
    <div class="rt-trust" {{ block.shopify_attributes }}>
      <ul class="rt-trust__list" role="list">
        {%- for i in (1..3) -%}
          {%- assign tk = 'text_' | append: i -%}
          {%- assign ik = 'icon_' | append: i -%}
          {%- if block.settings[tk] != blank -%}
            <li>{%- render 'icon' with block.settings[ik], width: 26, height: 26 -%}<span>{{ block.settings[tk] | escape }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if block.settings.show_payment_icons and block.settings.payment_types != blank -%}
        {%- assign wanted = block.settings.payment_types | remove: ' ' | split: ',' -%}
        <ul class="rt-trust__pay" role="list">
          {%- for type in wanted -%}
            {%- if shop.enabled_payment_types contains type -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
{%- endcase -%}
